{
  "name": "ygo-trainer",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.17",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "ocgcore-wasm": "^0.1.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "npm run build:engine && expo start --web",
    "export:web": "npm run build:engine && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "build:prod": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "test:e2e": "npm run build:engine && expo export --platform web --output-dir dist && node test/e2e/smoke.js",
    "test:engine": "node scripts/test-engine.mjs",
    "fixtures:engine": "node scripts/engine-fixtures.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "postinstall": "node scripts/build-engine.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
